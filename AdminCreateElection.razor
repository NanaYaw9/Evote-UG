@page "/admin/elections/create"
@inject EVoteUG.Client.Services.ElectionService ElectionService
@using EVoteUG.Shared.Enums

<PageTitle>Create Election</PageTitle>

<AdminGuard>
    <h1>Create New Election</h1>

    <div class="card" style="max-width: 500px;">
        <div>
            <label>Title</label>
            <input @bind="newElection.Title" style="width: 100%; box-sizing: border-box;" />
        </div>

        <div>
            <label>Description</label>
            <textarea @bind="newElection.Description" style="width: 100%; box-sizing: border-box;"></textarea>
        </div>

        <div>
            <label>Academic Year</label>
            <input @bind="newElection.AcademicYear" style="width: 100%; box-sizing: border-box;" />
        </div>

        <div>
            <label>Scope</label>
            <select @bind="newElection.Scope" style="width: 100%; box-sizing: border-box;">
                @foreach (var scope in Enum.GetValues<ElectionScope>())
                {
                    <option value="@scope">@scope</option>
                }
            </select>
        </div>

        <div>
            <label>Start Date</label>
            <input type="date" @bind="newElection.StartDate" style="width: 100%; box-sizing: border-box;" />
        </div>

        <div>
            <label>End Date</label>
            <input type="date" @bind="newElection.EndDate" style="width: 100%; box-sizing: border-box;" />
        </div>

        <button @onclick="HandleSubmit" style="margin-top: 1.5rem;">Create Election</button>

        @if (!string.IsNullOrEmpty(resultMessage))
        {
            <p>@resultMessage</p>
        }
    </div>
</AdminGuard>

@code {
    private EVoteUG.Client.Services.CreateElectionRequest newElection = new();
    private string? resultMessage;

    private async Task HandleSubmit()
    {
        var result = await ElectionService.CreateElectionAsync(newElection);
        resultMessage = result.Message;

        if (result.Success)
        {
            newElection = new();
        }
    }
}