@page "/admin/positions/create"
@inject EVoteUG.Client.Services.PositionService PositionService
@inject EVoteUG.Client.Services.ElectionService ElectionService

<PageTitle>Create Position</PageTitle>

<AdminGuard>
    <h1>Create New Position</h1>

    @if (elections == null)
    {
        <p>Loading elections...</p>
    }
    else
    {
        <div class="card" style="max-width: 500px;">
            <div>
                <label>Election</label>
                <select @bind="newPosition.ElectionId" style="width: 100%; box-sizing: border-box;">
                    <option value="0">-- Select an Election --</option>
                    @foreach (var election in elections)
                    {
                        <option value="@election.Id">@election.Title</option>
                    }
                </select>
            </div>

            <div>
                <label>Position Title</label>
                <input @bind="newPosition.Title" style="width: 100%; box-sizing: border-box;" />
            </div>

            <div>
                <label>Description</label>
                <textarea @bind="newPosition.Description" style="width: 100%; box-sizing: border-box;"></textarea>
            </div>

            <button @onclick="HandleSubmit" style="margin-top: 1.5rem;">Create Position</button>

            @if (!string.IsNullOrEmpty(resultMessage))
            {
                <p>@resultMessage</p>
            }
        </div>
    }
</AdminGuard>

@code {
    private EVoteUG.Client.Services.CreatePositionRequest newPosition = new();
    private List<EVoteUG.Client.Services.ElectionResponse>? elections;
    private string? resultMessage;

    protected override async Task OnInitializedAsync()
    {
        elections = await ElectionService.GetElectionsAsync();
    }

    private async Task HandleSubmit()
    {
        var result = await PositionService.CreatePositionAsync(newPosition);
        resultMessage = result.Message;

        if (result.Success)
        {
            newPosition = new();
        }
    }
}