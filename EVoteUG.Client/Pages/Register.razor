@page "/register"
@inject EVoteUG.Client.Services.StudentService StudentService
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager

<PageTitle>Register</PageTitle>

<div class="card" style="max-width: 400px; margin: 3rem auto; padding: 2rem;">
    <h1 style="text-align: center; font-size: 1.6rem; margin-bottom: 1.5rem;">Student Registration</h1>

    <div>
        <label>Student ID</label>
        <input @bind="request.StudentId" style="width: 100%; box-sizing: border-box;" />
    </div>

    <div>
        <label>Full Name</label>
        <input @bind="request.FullName" style="width: 100%; box-sizing: border-box;" />
    </div>

    <div>
        <label>Email</label>
        <input type="email" @bind="request.Email" style="width: 100%; box-sizing: border-box;" />
    </div>

    <div>
        <label>Password</label>
        <input type="password" @bind="request.Password" style="width: 100%; box-sizing: border-box;" />
    </div>

    <div>
        <label>College</label>
        <input @bind="request.College" style="width: 100%; box-sizing: border-box;" />
    </div>

    <div>
        <label>Faculty</label>
        <input @bind="request.Faculty" style="width: 100%; box-sizing: border-box;" />
    </div>

    <div>
        <label>Department</label>
        <input @bind="request.Department" style="width: 100%; box-sizing: border-box;" />
    </div>

    <div>
        <label>Hall of Residence</label>
        <input @bind="request.HallOfResidence" style="width: 100%; box-sizing: border-box;" />
    </div>

    <div>
        <label>Level</label>
        <select @bind="request.Level" style="width: 100%; box-sizing: border-box;">
            <option value="100">100</option>
            <option value="200">200</option>
            <option value="300">300</option>
            <option value="400">400</option>
        </select>
    </div>

    <button @onclick="HandleRegister" style="width: 100%; margin-top: 1.5rem;">Register</button>

    @if (!string.IsNullOrEmpty(resultMessage))
    {
        <p style="text-align: center; margin-top: 1rem;">@resultMessage</p>
    }
</div>

@code {
    private EVoteUG.Client.Services.StudentRegisterRequest request = new();
    private string? resultMessage;

    private async Task HandleRegister()
    {
        var result = await StudentService.RegisterAsync(request);
        resultMessage = result.Message;

        if (result.Success)
        {
            NavigationManager.NavigateTo("/login");
        }
    }
}
