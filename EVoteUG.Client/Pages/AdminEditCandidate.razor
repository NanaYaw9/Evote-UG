@page "/admin/candidates/edit/{CandidateId:int}"
@inject EVoteUG.Client.Services.CandidateService CandidateService

<PageTitle>Edit Candidate</PageTitle>

<AdminGuard>
    <h1>Edit Candidate</h1>

    @if (editRequest == null)
    {
        <p>Loading...</p>
    }
    else
    {
        <div class="card" style="max-width: 500px;">
            <div>
                <label>Full Name</label>
                <input @bind="editRequest.FullName" style="width: 100%; box-sizing: border-box;" />
            </div>

            <div>
                <label>Nickname</label>
                <input @bind="editRequest.Nickname" style="width: 100%; box-sizing: border-box;" />
            </div>

            <div>
                <label>Bio</label>
                <textarea @bind="editRequest.Bio" style="width: 100%; box-sizing: border-box;"></textarea>
            </div>

            <button @onclick="HandleSubmit" style="margin-top: 1.5rem;">Save Changes</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(resultMessage))
    {
        <p>@resultMessage</p>
    }
</AdminGuard>

@code {
    [Parameter]
    public int CandidateId { get; set; }

    private EVoteUG.Client.Services.CreateCandidateRequest? editRequest;
    private string? resultMessage;

    protected override async Task OnInitializedAsync()
    {
        var candidate = await CandidateService.GetCandidateByIdAsync(CandidateId);
        if (candidate != null)
        {
            editRequest = new EVoteUG.Client.Services.CreateCandidateRequest
            {
                PositionId = candidate.PositionId,
                StudentId = candidate.StudentId,
                FullName = candidate.FullName,
                Nickname = candidate.Nickname,
                Bio = candidate.Bio,
                RunningMateName = candidate.RunningMateName
            };
        }
    }

    private async Task HandleSubmit()
    {
        if (editRequest == null) return;

        var result = await CandidateService.UpdateCandidateAsync(CandidateId, editRequest);
        resultMessage = result.Message;
    }
}