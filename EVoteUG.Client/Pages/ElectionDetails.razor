@page "/elections/{ElectionId:int}"
@inject EVoteUG.Client.Services.PositionService PositionService
@inject EVoteUG.Client.Services.VoteService VoteService
@using EVoteUG.Shared.Models

<PageTitle>Election Details</PageTitle>

<h1>Positions</h1>

@if (positions == null)
{
    <p>Loading...</p>
}
else if (positions.Count == 0)
{
    <p>No positions found for this election.</p>
}
else
{
    @foreach (var position in positions)
    {
        <h3>@position.Title</h3>

        @if (position.Candidates == null || position.Candidates.Count == 0)
        {
            <p><em>No candidates yet.</em></p>
        }
        else
        {
            @foreach (var candidate in position.Candidates)
            {
                <div>
                    <label>
                        <input type="radio"
                               name="position-@position.Id"
                               value="@candidate.Id"
                               @onchange="() => SelectCandidate(position.Id, candidate.Id)" />
                        @candidate.FullName — @candidate.Bio
                    </label>
                </div>
            }
        }
    }

    <br />
    <button @onclick="SubmitVotes">Submit My Votes</button>

    @if (!string.IsNullOrEmpty(resultMessage))
    {
        <p>@resultMessage</p>
    }
}

@code {
    [Parameter]
    public int ElectionId { get; set; }

    private List<Position>? positions;
    private Dictionary<int, int> selections = new();
    private string? resultMessage;

    // TEMPORARY: hardcoded until real login exists
    private const int CurrentStudentId = 1;

    protected override async Task OnInitializedAsync()
    {
        var basicPositions = await PositionService.GetPositionsByElectionAsync(ElectionId);

        positions = new List<Position>();
        foreach (var pos in basicPositions)
        {
            var fullPosition = await PositionService.GetPositionWithCandidatesAsync(pos.Id);
            if (fullPosition != null)
                positions.Add(fullPosition);
        }
    }

    private void SelectCandidate(int positionId, int candidateId)
    {
        selections[positionId] = candidateId;
    }

    private async Task SubmitVotes()
    {
        resultMessage = "Submitting...";

        foreach (var selection in selections)
        {
            var vote = new Vote
            {
                StudentId = CurrentStudentId,
                PositionId = selection.Key,
                CandidateId = selection.Value
            };

            var result = await VoteService.CastVoteAsync(vote);

            if (!result.Success)
            {
                resultMessage = $"Error: {result.Message}";
                return;
            }
        }

        resultMessage = "All votes submitted successfully!";
    }
}