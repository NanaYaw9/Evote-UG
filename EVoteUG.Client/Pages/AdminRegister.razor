@page "/admin/register"
@inject EVoteUG.Client.Services.AdminService AdminService

<PageTitle>Register Admin</PageTitle>

    <div class="card" style="max-width: 400px; margin: 3rem auto; padding: 2rem;">
        <h1 style="text-align: center; font-size: 1.6rem; margin-bottom: 1.5rem;">Register New Admin</h1>

        <div>
            <label>Username</label>
            <input @bind="request.Username" style="width: 100%; box-sizing: border-box;" />
        </div>

        <div>
            <label>Full Name</label>
            <input @bind="request.FullName" style="width: 100%; box-sizing: border-box;" />
        </div>

        <div>
            <label>Email</label>
            <input type="email" @bind="request.Email" style="width: 100%; box-sizing: border-box;" />
        </div>

        <div>
            <label>Password</label>
            <input type="password" @bind="request.Password" style="width: 100%; box-sizing: border-box;" />
        </div>

        <button @onclick="HandleRegister" style="width: 100%; margin-top: 1.5rem;">Register Admin</button>

        @if (!string.IsNullOrEmpty(resultMessage))
        {
            <p style="text-align: center; margin-top: 1rem;">@resultMessage</p>
        }
    </div>

@code {
    private EVoteUG.Client.Services.AdminRegisterRequest request = new();
    private string? resultMessage;

    private async Task HandleRegister()
    {
        var result = await AdminService.RegisterAsync(request);
        resultMessage = result.Message;

        if (result.Success)
        {
            request = new();
        }
    }
}