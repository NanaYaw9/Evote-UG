@page "/elections/{ElectionId:int}/results"
@inject EVoteUG.Client.Services.PositionService PositionService
@inject EVoteUG.Client.Services.ResultService ResultService
@using EVoteUG.Shared.Models

<PageTitle>Election Results</PageTitle>

<h1>Results</h1>

@if (positions == null)
{
    <p>Loading...</p>
}
else if (positions.Count == 0)
{
    <p>No positions found for this election.</p>
}
else
{
    @foreach (var position in positions)
    {
        <h3>@position.Title</h3>

        @if (resultsByPosition.TryGetValue(position.Id, out var results) && results.Count > 0)
        {
            <ul>
                @foreach (var result in results)
                {
                    <li>@result.CandidateName — @result.VoteCount vote(s)</li>
                }
            </ul>
        }
        else
        {
            <p><em>No candidates or votes yet.</em></p>
        }
    }
}

@code {
    [Parameter]
    public int ElectionId { get; set; }

    private List<Position>? positions;
    private Dictionary<int, List<EVoteUG.Client.Services.ResultItem>> resultsByPosition = new();

    protected override async Task OnInitializedAsync()
    {
        positions = await PositionService.GetPositionsByElectionAsync(ElectionId);

        foreach (var position in positions)
        {
            var results = await ResultService.GetResultsAsync(position.Id);
            resultsByPosition[position.Id] = results;
        }
    }
}