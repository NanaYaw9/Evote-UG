@page "/admin/login"
@inject EVoteUG.Client.Services.AdminService AdminService
@inject EVoteUG.Client.Services.AuthState AuthState
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager

<PageTitle>Admin Login</PageTitle>

<div class="card" style="max-width: 400px; margin: 3rem auto; padding: 2rem;">
    <h1 style="text-align: center; font-size: 1.6rem; margin-bottom: 1.5rem;">Admin Login</h1>

    <div>
        <label>Username</label>
        <input @bind="username" style="width: 100%; box-sizing: border-box;" />
    </div>

    <div>
        <label>Password</label>
        <input type="password" @bind="password" style="width: 100%; box-sizing: border-box;" />
    </div>

    <button @onclick="HandleLogin" style="width: 100%; margin-top: 1.5rem;">Login</button>

    @if (!string.IsNullOrEmpty(resultMessage))
    {
        <p style="color: var(--status-danger); text-align: center; margin-top: 1rem;">@resultMessage</p>
    }
</div>

@code {
    private string username = string.Empty;
    private string password = string.Empty;
    private string? resultMessage;

    private async Task HandleLogin()
    {
        var result = await AdminService.LoginAsync(username, password);

        if (result.Success && result.Admin != null)
        {
            await AuthState.LogInAdminAsync(result.Admin);
            NavigationManager.NavigateTo("/admin");
        }
        else
        {
            resultMessage = result.Message;
        }
    }
}