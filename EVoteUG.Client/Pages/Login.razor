@page "/login"
@inject EVoteUG.Client.Services.StudentService StudentService
@inject EVoteUG.Client.Services.AuthState AuthState
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

<div class="card" style="max-width: 400px; margin: 3rem auto; padding: 2rem;">
    <h1 style="text-align: center; font-size: 1.6rem; margin-bottom: 1.5rem;">Student Login</h1>

    <div>
        <label>Student ID</label>
        <input @bind="studentId" style="width: 100%; box-sizing: border-box;" />
    </div>

    <div>
        <label>Password</label>
        <input type="password" @bind="password" style="width: 100%; box-sizing: border-box;" />
    </div>

    <button @onclick="HandleLogin" style="width: 100%; margin-top: 1.5rem;">Login</button>

    <p style="text-align: center; margin-top: 1rem;">
        <a href="/register">Don't have an account? Register here</a>
    </p>

    @if (!string.IsNullOrEmpty(resultMessage))
    {
        <p style="color: var(--status-danger); text-align: center;">@resultMessage</p>
    }
</div>

@code {
    private string studentId = string.Empty;
    private string password = string.Empty;
    private string? resultMessage;

    private async Task HandleLogin()
    {
        var result = await StudentService.LoginAsync(studentId, password);

        if (result.Success && result.User != null)
        {
            await AuthState.LogInAsync(result.User);
            NavigationManager.NavigateTo("/elections");
        }
        else
        {
            resultMessage = result.Message;
        }
    }
}