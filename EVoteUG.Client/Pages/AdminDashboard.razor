@page "/admin"
@inject EVoteUG.Client.Services.ElectionService ElectionService
@inject EVoteUG.Client.Services.PositionService PositionService

<PageTitle>Admin Dashboard</PageTitle>

<AdminGuard>
    <h1>Admin Dashboard</h1>

    <div style="display: flex; gap: 0.75rem; margin: 1.5rem 0;">
        <a href="/admin/elections/create" style="text-decoration: none;">
            <button>+ Create Election</button>
        </a>
        <a href="/admin/positions/create" style="text-decoration: none;">
            <button style="background-color: var(--bg-panel-hover);">+ Create Position</button>
        </a>
        <a href="/admin/candidates/create" style="text-decoration: none;">
            <button style="background-color: var(--bg-panel-hover);">+ Create Candidate</button>
        </a>
    </div>

    @if (elections != null)
    {
        <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem;">
            <div class="card" style="flex: 1;">
                <small style="color: var(--text-muted);">Total Elections</small>
                <div style="font-size: 1.8rem; font-weight: 700;">@elections.Count</div>
            </div>
            <div class="card" style="flex: 1;">
                <small style="color: var(--text-muted);">Active Elections</small>
                <div style="font-size: 1.8rem; font-weight: 700; color: var(--status-success);">@ActiveCount()</div>
            </div>
        </div>
    }

    <h3>Manage Elections</h3>
    @if (elections == null)
    {
        <p>Loading...</p>
    }
    else if (elections.Count == 0)
    {
        <p>No elections yet.</p>
    }
    else
    {
        @foreach (var election in elections)
        {
            <div class="card">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
                    <div>
                        <strong>@election.Title</strong>
                        @if (election.StatusName == "Active")
                        {
                            <span class="badge badge-active">@election.StatusName</span>
                        }
                        else
                        {
                            <span class="badge badge-closed">@election.StatusName</span>
                        }
                        <br />
                        <small style="color: var(--text-muted);">
                            @election.StartDate.ToShortDateString() to @election.EndDate.ToShortDateString()
                        </small>
                    </div>
                    <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                        <a href="/elections/@election.Id">View</a>
                        <a href="/elections/@election.Id/results">Results</a>

                        @if (election.StatusName == "Draft" || election.StatusName == "Scheduled" || election.StatusName == "Paused")
                        {
                            <button style="background-color: var(--status-success);" @onclick="() => SetStatus(election.Id, 3)">Activate</button>
                        }
                        @if (election.StatusName == "Active")
                        {
                            <button style="background-color: var(--status-danger);" @onclick="() => SetStatus(election.Id, 5)">Conclude</button>
                        }

                        <button style="background-color: var(--status-danger);" @onclick="() => DeleteElection(election.Id)">Delete</button>
                    </div>
                </div>

                @if (statusMessages.TryGetValue(election.Id, out var msg))
                {
                    <p style="margin-top: 0.5rem; margin-bottom: 0;"><small>@msg</small></p>
                }
            </div>
        }
    }
</AdminGuard>

@code {
    private List<EVoteUG.Client.Services.ElectionResponse>? elections;
    private Dictionary<int, string> statusMessages = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadElections();
    }

    private async Task LoadElections()
    {
        elections = await ElectionService.GetElectionsAsync();
    }

    private int ActiveCount()
    {
        if (elections == null) return 0;
        return elections.Count(e => e.StatusName == "Active");
    }

    private async Task SetStatus(int id, int newStatus)
    {
        var result = await ElectionService.UpdateElectionStatusAsync(id, newStatus);
        statusMessages[id] = result.Message;

        if (result.Success)
        {
            await LoadElections();
        }
    }

    private async Task DeleteElection(int id)
    {
        var result = await ElectionService.DeleteElectionAsync(id);
        statusMessages[id] = result.Message;

        if (result.Success)
        {
            await LoadElections();
        }
    }
}