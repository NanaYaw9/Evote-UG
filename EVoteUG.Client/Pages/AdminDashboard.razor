@page "/admin"
@inject EVoteUG.Client.Services.ElectionService ElectionService
@inject EVoteUG.Client.Services.PositionService PositionService
@using EVoteUG.Shared.Models

<PageTitle>Admin Dashboard</PageTitle>

<AdminGuard>
    <h1>Admin Dashboard</h1>

    <div style="display: flex; gap: 0.75rem; margin: 1.5rem 0;">
        <a href="/admin/elections/create" style="text-decoration: none;">
            <button>+ Create Election</button>
        </a>
        <a href="/admin/positions/create" style="text-decoration: none;">
            <button style="background-color: var(--bg-panel-hover);">+ Create Position</button>
        </a>
        <a href="/admin/candidates/create" style="text-decoration: none;">
            <button style="background-color: var(--bg-panel-hover);">+ Create Candidate</button>
        </a>
    </div>

    @if (elections != null)
    {
        <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem;">
            <div class="card" style="flex: 1;">
                <small style="color: var(--text-muted);">Total Elections</small>
                <div style="font-size: 1.8rem; font-weight: 700;">@elections.Count</div>
            </div>
            <div class="card" style="flex: 1;">
                <small style="color: var(--text-muted);">Active Elections</small>
                <div style="font-size: 1.8rem; font-weight: 700; color: var(--status-success);">@ActiveCount()</div>
            </div>
        </div>
    }

    <h3>Manage Elections</h3>
    @if (elections == null)
    {
        <p>Loading...</p>
    }
    else if (elections.Count == 0)
    {
        <p>No elections yet.</p>
    }
    else
    {
        @foreach (var election in elections)
        {
            <div class="card" style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <strong>@election.Title</strong>
                    <br />
                    <small style="color: var(--text-muted);">
                        @election.StartDate.ToShortDateString() to @election.EndDate.ToShortDateString()
                    </small>
                </div>
                <div style="display: flex; gap: 0.75rem;">
                    <a href="/elections/@election.Id">View</a>
                    <a href="/elections/@election.Id/results">Results</a>
                </div>
            </div>
        }
    }
</AdminGuard>

@code {
    private List<Election>? elections;

    protected override async Task OnInitializedAsync()
    {
        elections = await ElectionService.GetElectionsAsync();
    }

    private int ActiveCount()
    {
        if (elections == null) return 0;
        return elections.Count(e => e.IsActive && DateTime.UtcNow <= e.EndDate);
    }
}